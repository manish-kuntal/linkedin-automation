# SAFE DEFAULTS
AGENT_MODE=SAFE_DEMO

# AI provider (optional; offline heuristic works without it)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

USER_INTERESTS=AI, machine learning, startups, software engineering, cloud

# LinkedIn official API — KEEP FALSE unless you have the required official authorization
LINKEDIN_OFFICIAL_API_ENABLED=false
LINKEDIN_API_APPROVED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Safety limits
MAX_ACTIONS_PER_DAY=5
MAX_COMMENTS_PER_DAY=3
COOLDOWN_SECONDS=3600
MAX_SUGGESTIONS=3

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DESKTOP_NOTIFICATIONS=false
